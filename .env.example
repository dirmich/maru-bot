# 공통 / 로컬 실행 (실제 .env는 Git에 올리지 않습니다)
MARUBOT_ADMIN_ADDR=127.0.0.1:8000
MARUBOT_ADMIN_PUBLIC_URL=http://localhost:8000
MARUBOT_ADMIN_DATA=admin-data

# Frontend: 동일 backend가 정적 화면을 제공하므로 브라우저에 비밀을 전달하지 않습니다

# Backend: Google OAuth 웹 애플리케이션 자격 자료
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HTTPS 직접 수신 또는 loopback 뒤 HTTPS reverse proxy
MARUBOT_ADMIN_CERT=
MARUBOT_ADMIN_KEY=
# 자체 CA를 쓸 때만 지정합니다 (Tailscale 인증서는 OS 신뢰 저장소 사용 가능)
MARUBOT_CONTROL_CA=
# 자연어 계획에 사용할 기존 marubot config.json의 경로 (선택)
MARUBOT_ADMIN_LLM_CONFIG=

# Backend / worker: 장비별로 별도 설정합니다. 실제 값은 Admin 등록 화면에서 발급합니다
MARUBOT_CONTROL_URL=
MARUBOT_OWNER_ID=
MARUBOT_NODE_ID=
MARUBOT_NODE_TOKEN=
MARUBOT_WORKER_ADDR=127.0.0.1:8443
MARUBOT_WORKER_CERT=
MARUBOT_WORKER_KEY=
# 도구는 명시적으로 허용하며 기본값은 실행 거부입니다
MARUBOT_WORKER_TOOLS=system_status
